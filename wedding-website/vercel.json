{
  "redirects": [
    { "source": "/", "destination": "/wedding", "permanent": false }
  ],
  "rewrites": [
    { "source": "/wedding/api/:path*", "destination": "/api/:path*" },
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/wedding/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/wedding/vite.svg", "destination": "/vite.svg" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
